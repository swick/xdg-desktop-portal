<node name="/" xmlns:doc="http://www.freedesktop.org/dbus/1.0/doc.dtd">
  <!--
      org.freedesktop.impl.portal.Entitlements:
      @short_description: Portal for FIXME

      FIXME description

      This documentation describes version 1 of this interface.
  -->
  <interface name="org.freedesktop.impl.portal.Entitlements">

    <!--
        Enable:
        @handle: Object path for the :ref:`org.freedesktop.impl.portal.Request`
                 object representing this call
        @entitlements: The entitlements to enable
        @app_id: App id of the application
        @parent_window: Identifier for the application window,
                        see :doc:`window-identifiers`
        @options: Vardict with optional further information
        @response: Numeric Request response
        @results: Vardict with the results of the call

        Requests the user to enable the @entitlements listed, and disable any
        entitlements not listed. This can result in any entitlement being
        enabled or disabled, even entitlements not included in the method.

        Entitlements can also change at any other time.

        Only entitlements which are explicitly listed in the app metadata
        are ever going to be enabled.

        The keys in the @entitlements vardict are the identifiers of
        entitlements. The value is either a boolean, or an array of strings.

        Entitlements the impl does not know about should not get enabled.

        The impl is responsible for updating the permission store with the
        new state of the entitlements. The table `entitlements` is used where
        the resource ID is the app ID and the entitlements are stored in the
        `data` with the same encoding as here.

        The impl gets an already filtered view of the entitlements and should
        show a UI which shows the requested state of a whole group of
        entitlements at once (The widest scope of the entitlement is the group,
        so for `deeplink.origins`, to group is `deeplink`). The user should be
        able to selectively disable the entitlements and reject the whole group.

        There are no supported keys in the @options vardict.

        There are currently no supported keys in the @results vardict.
    -->
    <method name="Enable">
      <arg type="o" name="handle" direction="in"/>
      <arg type="a{sv}" name="entitlements" direction="in"/>
      <arg type="s" name="app_id" direction="in"/>
      <arg type="s" name="parent_window" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In4" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="u" name="response" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out1" value="QVariantMap"/>
      <arg type="a{sv}" name="results" direction="out"/>
    </method>

    <property name="version" type="u" access="read"/>
  </interface>
</node>
